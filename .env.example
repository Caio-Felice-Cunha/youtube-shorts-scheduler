# Copy this file to ".env" and fill in YOUR values. ".env" is gitignored.

# Path to the videos referenced by your manifest (relative or absolute).
VIDEOS_DIR=videos

# The CDP endpoint of the Chrome you launched with --remote-debugging-port.
# Default works if you used port 9222 (see README "One-time setup").
DEBUG_PORT=9222
# CDP_URL=http://localhost:9222

# YouTube interprets schedule times in YOUR CHANNEL'S timezone (set in Studio
# > Settings). This tool types the wall-clock time from your manifest as-is,
# so just write times in your channel timezone. This var is only a reminder.
CHANNEL_TIMEZONE=America/Los_Angeles

# Optional: spacing (minutes) between uploads in a batch run.
BATCH_SPACING_MINUTES=2
